# Sao chép file này thành .env và điền giá trị thực.
# KHÔNG bao giờ commit file .env lên git.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=gavel_db
# TiDB Cloud TLS is enabled automatically based on DB_HOST; set true for other TLS databases.
DB_SSL=false
# Optional: paste the complete CA certificate PEM if Node.js does not trust the server certificate.
DB_SSL_CA=

# --- Bảo mật ---
# BẮT BUỘC phải đặt giá trị dài, ngẫu nhiên. Server sẽ từ chối khởi động nếu thiếu.
JWT_SECRET=change_me_to_a_long_random_string

# --- SMTP (dùng gửi xác minh email và link đặt lại mật khẩu) ---
# Dùng thông tin SMTP của nhà cung cấp email; xác minh domain/sender trước khi deploy.
# Port 587 thường dùng SMTP_SECURE=false (STARTTLS); port 465 dùng SMTP_SECURE=true.
# npm run smtp:verify kiểm tra kết nối và xác thực mà không gửi email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="GAVEL <no-reply@example.com>"

# --- CORS ---
CLIENT_URL=http://localhost:3000

# --- Origin backend nhìn từ trình duyệt (dùng cho CSP: img-src / connect-src) ---
PUBLIC_API_URL=http://localhost:3001

# --- Server ---
PORT=3001

# --- Redis (tùy chọn, cho BullMQ background jobs) ---
# Nếu bỏ trống, server tự chuyển sang bộ lập lịch trong-process (không cần Redis).
REDIS_URL=redis://localhost:6379
