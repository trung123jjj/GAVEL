# ==========================================================
# GAVEL — file ignore ở gốc repo (áp dụng cho cả gavel-be và gavel-fe)
# ==========================================================

# ---------- Bí mật / cấu hình riêng tư ----------
# Chỉ commit *.env.example, KHÔNG BAO GIỜ commit file .env thật
.env
.env.*
!.env.example

# Khóa, chứng thư, thông tin đăng nhập
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*.ppk
secrets/
secrets.*
*credentials*
*.netrc

# ---------- Phụ thuộc ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
vendor/
bower_components/

# ---------- Kết quả build ----------
.next/
out/
build/
dist/
*.tsbuildinfo
.turbo/

# ---------- Test / coverage ----------
coverage/
.nyc_output/

# ---------- File do người dùng tải lên ----------
# File trong uploads/ là dữ liệu người dùng, không đưa lên git.
# Thư mục sẽ được tự tạo lại khi chạy (xem gavel-be/routes/upload.js).
gavel-be/uploads/*
!gavel-be/uploads/.gitkeep

# ---------- Log ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed

# ---------- Hệ điều hành / trình soạn thảo ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- Docker ----------
docker-compose.override.yml
docker-compose.local.yml
.docker-data/

# ---------- Gói nén / bản sao lưu ----------
# Bản zip nguồn chứa bản sao của cả thư mục (kèm file .env) — không commit.
gavel-src.zip
*.bak
*.backup
*.old
*.orig
*.zip
!package-lock.json

# ---------- Misc ----------
*.pid.lock
.envrc
.secrets
